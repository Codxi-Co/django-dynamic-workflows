#: django_workflow_engine/models.py:594
msgid "Whether this action is active"
msgstr "ما إذا كان هذا الإجراء نشطاً"

#: django_workflow_engine/models.py:604
msgid "Workflow this action belongs to (workflow-level action)"
msgstr "سير العمل الذي ينتمي إليه هذا الإجراء (إجراء على مستوى سير العمل)"

#: django_workflow_engine/models.py:612
