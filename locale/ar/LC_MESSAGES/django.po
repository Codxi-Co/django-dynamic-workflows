msgstr "معاملات إضافية لتمريرها إلى دالة الإجراء"

#: django_workflow_engine/models.py:631
msgid "Execution order when multiple actions exist for the same event"
msgstr "ترتيب التنفيذ عند وجود إجراءات متعددة لنفس الحدث"

