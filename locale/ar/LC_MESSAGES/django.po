msgstr "ملغي"

# Action types
msgid "Before Start"
msgstr "قبل البدء"

msgid "After Start"
msgstr "بعد البدء"

msgid "Before Approve"
msgstr "قبل الموافقة"

msgid "After Approve"
msgstr "بعد الموافقة"

msgid "Before Reject"
msgstr "قبل الرفض"

msgid "After Reject"
msgstr "بعد الرفض"

